#==========================================================
# 7. 各観測から播種時GDDを逆算
#==========================================================

stage_threshold <-

    stage_all %>%

    group_by(stage) %>%

    summarise(

        stageGDD = median(cumGDD, na.rm=TRUE),

        n = n(),

        .groups="drop"

    ) %>%

    arrange(stage)


print(stage_threshold)

#==========================================================
# V2到達までの必要GDD推定
#==========================================================

V2_GDD_required <-

stage_all %>%
    
    filter(stage==2) %>%
    
    summarise(
        
        V2_required =
            median(cumGDD - 
                   min(cumGDD),
                   na.rm=TRUE)
        
    )


print(V2_GDD_required)

#==========================================================
# 8. 実測データから播種GDDを推定
#==========================================================
seed_est <-

stage_all %>%

filter(
    !is.na(cumGDD),
    !is.na(stage)
) %>%

group_by(site,year) %>%

do({

    fit <- lm(stage ~ cumGDD, data=.)


    a <- coef(fit)[1]
    b <- coef(fit)[2]


    seedGDD <- -a/b


    tibble(

        seeding_GDD = seedGDD,

        slope=b,

        intercept=a,

        R2=summary(fit)$r.squared,

        n_obs=nrow(.)

    )


}) %>%

ungroup()



#==========================================================
# 8.5 負の播種GDDを補正
#==========================================================

seed_est <- seed_est %>%
    
    mutate(
        
        seeding_GDD =
            case_when(
                
                seeding_GDD < 0 ~ 0,
                
                seeding_GDD > 300 ~ 300,
                
                TRUE ~ seeding_GDD
                
            )
    )
#==========================================================
# 9. 播種GDD → 播種日へ変換
#==========================================================

find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year == yr)

    targetGDD <- max(targetGDD,0)

    idx <- which.min(
        abs(w$cumGDD-targetGDD)
    )

    w$date[idx]

}

seed_est$seeding_date <-

    mapply(
        find_date_from_gdd,
        seed_est$seeding_GDD_adj,
        seed_est$year
    )
