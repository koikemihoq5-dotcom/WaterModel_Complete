#==========================================================
# 5. 観測日に累積GDDを付与
#==========================================================

stage_all <-

    stage_all %>%

    select(-matches("cumGDD")) %>%

    left_join(

        weather %>%
            select(date, year, cumGDD),

        by = c("date","year")

    )
if(any(is.na(stage_all$cumGDD))){
    
    warning("累積GDDが取得できない日があります。")
    
}

#==========================================================
# 7. 各観測から播種時GDDを逆算
#==========================================================

stage_threshold <-

    stage_all %>%

    group_by(stage) %>%

    summarise(

        stageGDD = median(cumGDD, na.rm=TRUE),

        n = n(),

        .groups="drop"

    ) %>%

    arrange(stage)


print(stage_threshold)

#==========================================================
# V2到達までの必要GDD推定
#==========================================================

V2_GDD_required <-

stage_all %>%
    
    filter(stage==2) %>%
    
    summarise(
        
        V2_required =
            median(cumGDD - 
                   min(cumGDD),
                   na.rm=TRUE)
        
    )


print(V2_GDD_required)

#==========================================================
# 8. 実測Stageから播種GDDを推定
#==========================================================

seed_est <-

stage_all %>%

mutate(

    stageGDD =
        stage_threshold$stageGDD[
            match(stage, stage_threshold$stage)
        ],

    seedGDD =
        cumGDD - stageGDD

) %>%

group_by(site,year) %>%

summarise(

    seeding_GDD =
        median(seedGDD, na.rm=TRUE),

    sd_seedGDD =
        sd(seedGDD, na.rm=TRUE),

    n_obs=n(),

    .groups="drop"

)

#==========================================================
# 8.5 負の播種GDDを補正
#==========================================================

seed_est <- seed_est %>%
mutate(
    seeding_GDD =
        pmax(seeding_GDD,0)
)
#==========================================================
# 9. 播種GDD → 播種日へ変換
#==========================================================

find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year == yr)

    targetGDD <- max(targetGDD,0)

    idx <- which.min(
        abs(w$cumGDD-targetGDD)
    )

    w$date[idx]

}

seed_est$seeding_date <-

mapply(
    find_date_from_gdd,
    seed_est$seeding_GDD,
    seed_est$year
)

head(seed_est[,c(
    "site",
    "year",
    "seeding_GDD",
    "seeding_date"
)])
#==========================================================
# disease結合
#==========================================================

if(length(list_disease)>0){

    disease_all <- bind_rows(list_disease) %>%
        distinct(site,year,.keep_all=TRUE)


    seed_est <-

        left_join(
            seed_est,
            disease_all,
            by=c("site","year")
        )

}
