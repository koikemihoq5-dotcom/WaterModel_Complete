#==========================================================
# 5. 観測日に累積GDDを付与
#==========================================================

stage_all <-

    stage_all %>%

    select(-matches("cumGDD")) %>%

    left_join(

        weather %>%
            select(date, year, cumGDD),

        by = c("date","year")

    )
if(any(is.na(stage_all$cumGDD))){
    
    warning("累積GDDが取得できない日があります。")
    
}

#==========================================================
# 6. Stageごとの代表GDD
#==========================================================

GDD_STAGE <- c(
    
    "2"  = 583,
    "3"  = 570,
    "4"  = 662,
    "5"  = 552,
    "6"  = 675,
    "7"  = 687,
    "8"  = 761,
    "9"  = 786,
    "10" = 850,
    "11" = 859,
    "12" = 920,
    "13" = 920
    
)

#==========================================================
# 7. 各観測から播種時GDDを逆算
#==========================================================

stage_all <-
    
    stage_all %>%
    
    mutate(
        
        stageGDD =
            
            GDD_STAGE[as.character(stage)],
        
        seedGDD =
            
            cumGDD - stageGDD
        
    )

#==========================================================
# 8. 実測データから播種GDDを推定
#==========================================================

seed_est <-

stage_all %>%

filter(
    !is.na(cumGDD),
    !is.na(stage)
) %>%

group_by(site,year) %>%

do({

    fit <- lm(stage ~ cumGDD, data=.)


    # stage=0 の時のGDD
    seedGDD <- 
        -coef(fit)[1] / coef(fit)[2]


    tibble(

        seeding_GDD = seedGDD,

        slope = coef(fit)[2],

        intercept = coef(fit)[1],

        R2 = summary(fit)$r.squared,

        n_obs=nrow(.)


    )

}) %>%

ungroup()


print(head(seed_est))


#==========================================================
# 9. 播種GDD → 播種日へ変換
#==========================================================

find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year==yr)

    idx <- which.min(
        abs(w$cumGDD-targetGDD)
    )

    w$date[idx]

}

seed_est$seeding_date <-

mapply(
    find_date_from_gdd,
    seed_est$seeding_GDD,
    seed_est$year
),

origin="1970-01-01"

)

) %>%

select(

site,
year,
seeding_date,
n_obs,
seeding_GDD,
sd_seedGDD

)



