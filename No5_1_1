#==========================================================
# 5. 観測日に累積GDDを付与
#==========================================================

stage_all <-

    stage_all %>%

    select(-matches("cumGDD")) %>%

    left_join(

        weather %>%
            select(date, year, cumGDD),

        by = c("date","year")

    )
if(any(is.na(stage_all$cumGDD))){
    
    warning("累積GDDが取得できない日があります。")
    
}

#==========================================================
# 6. Stageごとの代表GDD
#==========================================================

GDD_STAGE <- c(
    
    "2"  = 583,
    "3"  = 570,
    "4"  = 662,
    "5"  = 552,
    "6"  = 675,
    "7"  = 687,
    "8"  = 761,
    "9"  = 786,
    "10" = 850,
    "11" = 859,
    "12" = 920,
    "13" = 920
    
)

#==========================================================
# 7. 各観測から播種時GDDを逆算
#==========================================================

stage_all <-
    
    stage_all %>%
    
    mutate(
        
        stageGDD =
            
            GDD_STAGE[as.character(stage)],
        
        seedGDD =
            
            cumGDD - stageGDD
        
    )

#==========================================================
# 8. 実測データから播種GDDを推定
#==========================================================

seed_est <-

stage_all %>%

mutate(

stageGDD =
case_when(

stage == 2 ~ 580,
stage == 3 ~ 570,
stage == 4 ~ 660,
stage == 5 ~ 650,
stage == 6 ~ 675,
stage == 7 ~ 687,
stage == 8 ~ 760,
stage == 9 ~ 786,
stage == 10 ~ 850,
stage == 11 ~ 860,
stage >=12 ~ 920

),

seedGDD =
cumGDD - stageGDD

) %>%

filter(!is.na(seedGDD)) %>%

group_by(site,year) %>%

summarise(

seeding_GDD =
mean(seedGDD,na.rm=TRUE),

sd_seedGDD =
sd(seedGDD,na.rm=TRUE),

n_obs=n(),

.groups="drop"

)


print(seed_est)



#==========================================================
# 9. 播種GDD → 播種日へ変換
#==========================================================

find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year == yr)

    idx <- which.min(
        abs(w$cumGDD - targetGDD)
    )

    w$date[idx]

}


crop_stage <-

seed_est %>%

mutate(

seeding_date =

as.Date(

mapply(

find_date_from_gdd,

seeding_GDD,

year

),

origin="1970-01-01"

)

) %>%

select(

site,
year,
seeding_date,
n_obs,
seeding_GDD,
sd_seedGDD

)



