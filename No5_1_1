#==========================================================
# 7. 各観測から播種時GDDを逆算
#==========================================================

stage_threshold <-

    stage_all %>%

    group_by(stage) %>%

    summarise(

        stageGDD = median(cumGDD, na.rm=TRUE),

        n = n(),

        .groups="drop"

    ) %>%

    arrange(stage)


print(stage_threshold)
#==========================================================
# 8. 実測データから播種GDDを推定（安定版）
#==========================================================

seed_est <-

stage_all %>%

filter(!is.na(cumGDD)) %>%

group_by(site,year) %>%

do({

    fit <- lm(stage ~ cumGDD, data=.)


    a <- coef(fit)[1]
    b <- coef(fit)[2]

    R2 <- summary(fit)$r.squared


    # 傾き異常を除外
    if(
        is.na(b) |
        abs(b) < 0.005 |
        R2 < 0.8 |
        nrow(.) < 3
    ){

        tibble(
            seeding_GDD = NA,
            V2_GDD = NA,
            slope=b,
            intercept=a,
            R2=R2,
            n_obs=nrow(.)
        )

    }else{


        V2_GDD <- (2-a)/b

        seedGDD <- V2_GDD - 583


        tibble(

            seeding_GDD = seedGDD,

            V2_GDD = V2_GDD,

            slope=b,

            intercept=a,

            R2=R2,

            n_obs=nrow(.)

        )

    }

}) %>%

ungroup()

seed_est <- seed_est %>%
    
    mutate(
        seeding_GDD =
            ifelse(
                seeding_GDD < 0,
                0,
                seeding_GDD
            )
    )
#==========================================================
# 9. 播種GDD → 播種日へ変換
#==========================================================

find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year == yr)

    targetGDD <- max(targetGDD,0)

    idx <- which.min(
        abs(w$cumGDD-targetGDD)
    )

    w$date[idx]

}


seed_est$seeding_date <-

    mapply(
        find_date_from_gdd,
        seed_est$seeding_GDD,
        seed_est$year
    )
