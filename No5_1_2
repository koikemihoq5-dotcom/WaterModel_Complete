#==========================================================
# 12. 播種日からV2,V5,R1到達日を推定
#==========================================================

# ステージ到達に必要なGDD
# stage 2 = V2
# stage 6 = V5
# stage 10 = R1

V2_required_GDD <- 583
V5_required_GDD <- 675
R1_required_GDD <- 850


# GDD → 日付変換関数
find_date_from_gdd <- function(targetGDD, yr){

    w <- weather %>%
        filter(year == yr)

    idx <- which.min(
        abs(w$cumGDD - targetGDD)
    )

    w$date[idx]

}


#----------------------------------------------------------
# ステージ日推定
#----------------------------------------------------------

crop_stage_predicted <-

seed_est %>%

mutate(

    # 播種日
    pred_seeding_date =
        as.Date(seeding_date),


    # 到達GDD
    V2_target_GDD =
        seeding_GDD + V2_required_GDD,

    V5_target_GDD =
        seeding_GDD + V5_required_GDD,

    R1_target_GDD =
        seeding_GDD + R1_required_GDD

) %>%


rowwise() %>%

mutate(

    v2_date =
        find_date_from_gdd(
            V2_target_GDD,
            year
        ),


    v5_date =
        find_date_from_gdd(
            V5_target_GDD,
            year
        ),


    r1_date =
        find_date_from_gdd(
            R1_target_GDD,
            year
        )

) %>%

ungroup()


library(dplyr)

#==========================================================
# disease 列の復元（seed_est に disease を結合）
#==========================================================
# stage_all から site, year ごとの disease を抽出して seed_est に追加
disease_summary <- stage_all %>%
  group_by(site, year) %>%
  summarise(disease = mean(disease, na.rm = TRUE), .groups = "drop")

seed_est <- seed_est %>%
  select(-any_of("disease")) %>% # 重複防止のため一度削除
  left_join(disease_summary, by = c("site", "year"))

#==========================================================
# ステージ日推定
#==========================================================
crop_stage_predicted <- seed_est %>%
  mutate(
    # 播種日
    pred_seeding_date = as.Date(seeding_date),
    
    # 到達GDD
    V2_target_GDD = seeding_GDD + V2_required_GDD,
    V5_target_GDD = seeding_GDD + V5_required_GDD,
    R1_target_GDD = seeding_GDD + R1_required_GDD
  ) %>%
  rowwise() %>%
  mutate(
    v2_date = find_date_from_gdd(V2_target_GDD, year),
    v5_date = find_date_from_gdd(V5_target_GDD, year),
    r1_date = find_date_from_gdd(R1_target_GDD, year)
  ) %>%
  ungroup()

#==========================================================
# 必要列だけ抽出・保存
#==========================================================
crop_stages_predicted <- crop_stage_predicted %>%
  select(
    site,
    year,
    pred_seeding_date,
    v2_date,
    v5_date,
    r1_date,
    disease
  )

# 保存
if (!dir.exists("01_ProcessedData")) {
  dir.create("01_ProcessedData", recursive = TRUE)
}

write.csv(
  crop_stages_predicted,
  "01_ProcessedData/crop_stages_predicted.csv",
  row.names = FALSE,
  fileEncoding = "CP932"
)

cat("\n--- ステージ推定日および disease の抽出・保存が完了しました！ ---\n")
print(head(crop_stages_predicted))
