# =========================================================
# 03_water_balance_model.R
# 水収支モデルのパラメータ最適化、連続推定、および精度評価（改変統合版）
# =========================================================

library(dplyr)
library(lubridate)
library(ggplot2)

# ---------------------------------------------------------
# 1. 前処理データの読み込み ＆ 欠損補正
# ---------------------------------------------------------
df_weather <- read.csv("01_ProcessedData/df_weather_cleaned.csv", stringsAsFactors = FALSE)
df_weather$date <- as.Date(df_weather$date)

# 降水量の NA を 0 に穴埋め（計算途切れ防止）
df_weather$rain[is.na(df_weather$rain)] <- 0

SMC_all <- read.csv("01_ProcessedData/SMC_all.csv", stringsAsFactors = FALSE)
SMC_all$date <- as.Date(SMC_all$date)

# 実測値が NA の行を除外
SMC_all_clean <- SMC_all %>% filter(!is.na(SMC_obs))


# ---------------------------------------------------------
# 2. 欠損値に対応した安定版最適化関数の定義
# ---------------------------------------------------------
estimate_parameters_stable <- function(df_weather, df_obs_site, 
                                        fixed_a = 0.5, fixed_AWHC = 40.0,
                                        init_params = c(Sd = 200, SMC0 = 0.05)) {
    
    if (nrow(df_obs_site) == 0) {
        return(list(par = init_params, value = NA))
    }
    
    objective_func <- function(params) {
        Sd   <- params[1]
        SMC0 <- params[2]
        
        if (Sd < 50 || Sd > 500 || SMC0 < 0 || SMC0 > 0.4) return(1e9)
        
        sim_res <- simulate_water(df_weather, a = fixed_a, AWHC = fixed_AWHC)
        sim_res$SMC_pred <- calc_SMC(sim_res$Aw, Sd = Sd, SMC0 = SMC0)
        
        merged <- merge(df_obs_site, sim_res, by = "date")
        merged <- merged[!is.na(merged$SMC_obs) & !is.na(merged$SMC_pred), ]
        
        if (nrow(merged) == 0) return(1e9)
        
        return(sum((merged$SMC_obs - merged$SMC_pred)^2))
    }
    
    opt <- optim(par = init_params, fn = objective_func, method = "Nelder-Mead")
    names(opt$par) <- c("Sd", "SMC0")
    return(opt)
}


# ---------------------------------------------------------
# 3. 地点別パラメータ最適化ループ
# ---------------------------------------------------------
sites <- unique(SMC_all_clean$site)
summary_params <- data.frame()

for (s in sites) {
    df_obs_site <- subset(SMC_all_clean, site == s)
    
    opt_out <- estimate_parameters_stable(
        df_weather = df_weather, 
        df_obs_site = df_obs_site,
        fixed_a = 0.5, 
        fixed_AWHC = 40.0, 
        init_params = c(Sd = 200, SMC0 = 0.05)
    )
    
    pars <- opt_out$par
    summary_params <- rbind(summary_params, data.frame(
        site = s, a = 0.5, AWHC = 40.0, Sd = pars["Sd"], SMC0 = pars["SMC0"], SSR = opt_out$value
    ))
}

write.csv(summary_params, "02_ModelOutputs/optimization_results_all.csv", row.names = FALSE, fileEncoding = "CP932")


# ---------------------------------------------------------
# 4. 栽培期間（6/1〜9/30）の全日連続推定
# ---------------------------------------------------------
df_weather_season <- df_weather %>%
    filter(month(date) %in% 6:9 & year(date) %in% 2023:2026)

df_pred_4years_all <- data.frame()

for (s in sites) {
    pars_target <- subset(summary_params, site == s)
    if (nrow(pars_target) > 0 && !is.na(pars_target$Sd)) {
        sim_full <- simulate_water(df_weather_season, a = pars_target$a, AWHC = pars_target$AWHC)
        sim_full$SMC_pred <- calc_SMC(sim_full$Aw, Sd = pars_target$Sd, SMC0 = pars_target$SMC0)
        sim_full$site <- s
        df_pred_4years_all <- rbind(df_pred_4years_all, sim_full[, c("date", "site", "rain", "et_p", "SMC_pred")])
    }
}

write.csv(df_pred_4years_all, "02_ModelOutputs/soil_moisture_pred_4years_full.csv", row.names = FALSE, fileEncoding = "CP932")


# ---------------------------------------------------------
# 5. 実測と推定データの結合ファイル出力（評価用）
# ---------------------------------------------------------
merged_data <- inner_join(SMC_all_clean, df_pred_4years_all, by = c("date", "site"))
write.csv(merged_data, "02_ModelOutputs/merged_SMC_all.csv", row.names = FALSE, fileEncoding = "CP932")

cat("✅ モデル最適化と推定結果の保存が完了しました: 02_ModelOutputs/\n")


# =========================================================
# 6. 視覚化処理
# =========================================================
dir.create("03_Plots", showWarnings = FALSE)

# ---------------------------------------------------------
# 6-1-A. 全体プロット（全年度統合散布図）
# ---------------------------------------------------------
merged_clean <- na.omit(merged_data[, c("SMC_obs", "SMC_pred")])
r2_val   <- cor(merged_clean$SMC_obs, merged_clean$SMC_pred)^2
rmse_val <- sqrt(mean((merged_clean$SMC_obs - merged_clean$SMC_pred)^2))
metrics_text <- paste0("R² = ", sprintf("%.2f", r2_val), "\nRMSE = ", sprintf("%.3f", rmse_val))

merged_data$year_factor <- factor(year(merged_data$date))

p_scatter_all <- ggplot(merged_data, aes(x = SMC_obs, y = SMC_pred)) +
    geom_point(aes(color = year_factor, shape = year_factor), size = 2.5, alpha = 0.8) +
    geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "gray40") +
    annotate("text", x = 0.02, y = 0.42, label = metrics_text, hjust = 0, vjust = 1, size = 5, fontface = "bold") +
    scale_x_continuous(limits = c(-0.02, 0.45), breaks = seq(0, 0.4, 0.1)) +
    scale_y_continuous(limits = c(-0.02, 0.45), breaks = seq(0, 0.4, 0.1)) +
    labs(
        x = "実測土壌体積含水量 (SMC)", 
        y = "推定土壌体積含水量 (SMC)", 
        color = "年", 
        shape = "年",
        title = "2024–2026年 実測 vs 推定"
    ) +
    theme_bw(base_size = 14) +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))

ggsave("03_Plots/SMC_Scatter_Plot.png", p_scatter_all, width = 6, height = 6, dpi = 300)


# ---------------------------------------------------------
# 6-1-B. 各年度別プロット (2024年, 2025年, 2026年個別散布図)
# ---------------------------------------------------------
years_list <- sort(unique(year(merged_data$date)))

for (yr in years_list) {
    merged_yr <- merged_data %>% filter(year(date) == yr)
    
    if (nrow(merged_yr) > 0) {
        m_clean <- na.omit(merged_yr[, c("SMC_obs", "SMC_pred")])
        r2_yr   <- cor(m_clean$SMC_obs, m_clean$SMC_pred)^2
        rmse_yr <- sqrt(mean((m_clean$SMC_obs - m_clean$SMC_pred)^2))
        text_yr <- paste0(yr, "\nR² = ", sprintf("%.2f", r2_yr), "\nRMSE = ", sprintf("%.3f", rmse_yr))
        
        p_scatter_yr <- ggplot(merged_yr, aes(x = SMC_obs, y = SMC_pred)) +
            geom_point(color = "#1F78B4", size = 2.5, alpha = 0.8) +
            geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "gray40") +
            annotate("text", x = 0.02, y = 0.42, label = text_yr, hjust = 0, vjust = 1, size = 5, fontface = "bold") +
            scale_x_continuous(limits = c(-0.02, 0.45), breaks = seq(0, 0.4, 0.1)) +
            scale_y_continuous(limits = c(-0.02, 0.45), breaks = seq(0, 0.4, 0.1)) +
            labs(
                x = "実測土壌体積含水量 (SMC)", 
                y = "推定土壌体積含水量 (SMC)", 
                title = paste0(yr, "年 実測 vs 推定")
            ) +
            theme_bw(base_size = 14) +
            theme(plot.title = element_text(hjust = 0.5, face = "bold"))
        
        # 年度別ファイル名で保存
        ggsave(paste0("03_Plots/SMC_Scatter_Plot_", yr, ".png"), p_scatter_yr, width = 6, height = 6, dpi = 300)
        
        # 2026年の別名保存指示にも対応
        if (yr == 2026) {
            ggsave("03_Plots/SMC_Scatter_Plot_2026median.png", p_scatter_yr, width = 6, height = 6, dpi = 300)
            ggsave("03_Plots/SMC_Scatter_Plot_2026Ave.png", p_scatter_yr, width = 6, height = 6, dpi = 300)
        }
    }
}


# ---------------------------------------------------------
# 6-2. 2024, 2025, 2026年 SMCと降水量プロット
# （濃い青の降水量バー + 「赤ポイント＝平均値」版 ＆ 「赤ポイント＝中央値」版）
# ---------------------------------------------------------
available_years <- sort(unique(year(df_pred_4years_all$date)))
precip_max <- max(df_weather$rain, na.rm = TRUE)
smc_max    <- 0.35
scale_factor <- precip_max / smc_max

for (y in available_years) {
    rain_y <- df_weather %>% filter(year(date) == y & month(date) %in% 6:9)
    
    # -----------------------------------------------------
    # ① 赤のポイント：平均値（Mean ± SD）図
    # -----------------------------------------------------
    pred_summary_ave <- df_pred_4years_all %>%
        filter(year(date) == y) %>%
        group_by(date) %>%
        summarize(
            SMC_pred_val = mean(SMC_pred, na.rm = TRUE),
            SMC_pred_sd  = sd(SMC_pred, na.rm = TRUE),
            .groups = "drop"
        ) %>%
        mutate(ymin = pmax(0, SMC_pred_val - SMC_pred_sd), ymax = SMC_pred_val + SMC_pred_sd)
    
    obs_summary_ave <- SMC_all_clean %>%
        filter(year(date) == y) %>%
        group_by(date) %>%
        summarize(SMC_obs_val = mean(SMC_obs, na.rm = TRUE), .groups = "drop")
    
    p_time_ave <- ggplot() +
        # 日降水量（濃い青色バー: #004488）
        geom_bar(data = rain_y, aes(x = date, y = rain / scale_factor, fill = "日降水量"), 
                 stat = "identity", width = 0.8, alpha = 0.7) +
        geom_ribbon(data = pred_summary_ave, aes(x = date, ymin = ymin, ymax = ymax, fill = "推定SMC (±SD)"), alpha = 0.25) +
        geom_line(data = pred_summary_ave, aes(x = date, y = SMC_pred_val, color = "推定SMC (平均)"), linewidth = 1) +
        geom_point(data = obs_summary_ave, aes(x = date, y = SMC_obs_val, color = "実測SMC (平均)"), size = 3) +
        scale_y_continuous(
            name = expression(bold(paste("SMC (m"^3, "/m"^3, ")"))), 
            limits = c(0, smc_max), 
            sec.axis = sec_axis(~ . * scale_factor, name = "降水量 (mm)")
        ) +
        scale_x_date(date_labels = "%m/%d", date_breaks = "15 days") +
        scale_color_manual(name = "", values = c("推定SMC (平均)" = "#1F78B4", "実測SMC (平均)" = "#E31A1C")) +
        scale_fill_manual(name = "", values = c("推定SMC (±SD)" = "#1F78B4", "日降水量" = "#004488")) +
        labs(title = paste0(y, "年 SMCおよび降水量 (平均値表示)"), x = paste0("日付 (", y, "年)")) +
        theme_bw(base_size = 12) +
        theme(
            plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
            axis.title.x = element_text(face = "bold"),
            axis.title.y.left = element_text(color = "#1F78B4", face = "bold"),
            axis.title.y.right = element_text(color = "#004488", face = "bold"),
            axis.text.x = element_text(angle = 45, hjust = 1),
            legend.position = "bottom", legend.box = "horizontal", panel.grid.minor = element_line(linetype = "dotted")
        )
    
    ggsave(paste0("03_Plots/SMC_TimeSeries_", y, "_Ave.png"), p_time_ave, width = 6, height = 7, dpi = 300)
    
    # -----------------------------------------------------
    # ② 赤のポイント：中央値（Median & 25-75%）図
    # -----------------------------------------------------
    pred_summary_med <- df_pred_4years_all %>%
        filter(year(date) == y) %>%
        group_by(date) %>%
        summarize(
            SMC_pred_val = median(SMC_pred, na.rm = TRUE),
            ymin         = quantile(SMC_pred, 0.25, na.rm = TRUE),
            ymax         = quantile(SMC_pred, 0.75, na.rm = TRUE),
            .groups = "drop"
        )
    
    obs_summary_med <- SMC_all_clean %>%
        filter(year(date) == y) %>%
        group_by(date) %>%
        summarize(SMC_obs_val = median(SMC_obs, na.rm = TRUE), .groups = "drop")
    
    p_time_med <- ggplot() +
        # 日降水量（濃い青色バー: #004488）
        geom_bar(data = rain_y, aes(x = date, y = rain / scale_factor, fill = "日降水量"), 
                 stat = "identity", width = 0.8, alpha = 0.7) +
        geom_ribbon(data = pred_summary_med, aes(x = date, ymin = ymin, ymax = ymax, fill = "推定SMC (25-75%)"), alpha = 0.25) +
        geom_line(data = pred_summary_med, aes(x = date, y = SMC_pred_val, color = "推定SMC (中央値)"), linewidth = 1) +
        geom_point(data = obs_summary_med, aes(x = date, y = SMC_obs_val, color = "実測SMC (中央値)"), size = 3) +
        scale_y_continuous(
            name = expression(bold(paste("SMC (m"^3, "/m"^3, ")"))), 
            limits = c(0, smc_max), 
            sec.axis = sec_axis(~ . * scale_factor, name = "降水量 (mm)")
        ) +
        scale_x_date(date_labels = "%m/%d", date_breaks = "15 days") +
        scale_color_manual(name = "", values = c("推定SMC (中央値)" = "#1F78B4", "実測SMC (中央値)" = "#E31A1C")) +
        scale_fill_manual(name = "", values = c("推定SMC (25-75%)" = "#1F78B4", "日降水量" = "#004488")) +
        labs(title = paste0(y, "年 SMCおよび降水量 (中央値表示)"), x = paste0("日付 (", y, "年)")) +
        theme_bw(base_size = 12) +
        theme(
            plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
            axis.title.x = element_text(face = "bold"),
            axis.title.y.left = element_text(color = "#1F78B4", face = "bold"),
            axis.title.y.right = element_text(color = "#004488", face = "bold"),
            axis.text.x = element_text(angle = 45, hjust = 1),
            legend.position = "bottom", legend.box = "horizontal", panel.grid.minor = element_line(linetype = "dotted")
        )
    
    ggsave(paste0("03_Plots/SMC_TimeSeries_", y, "_median.png"), p_time_med, width = 6, height = 7, dpi = 300)
}

cat("🎉 処理が完了しました！\n")
cat(" 📁 出力画像一覧 (03_Plots/):\n")
cat("   - SMC_Scatter_Plot.png (2024-2026年 全体散布図)\n")
cat("   - SMC_Scatter_Plot_2024.png / 2025.png / 2026.png (各年個別散布図)\n")
cat("   - SMC_TimeSeries_YYYY_Ave.png (2024, 2025, 2026年 平均値時系列図・濃い青棒)\n")
cat("   - SMC_TimeSeries_YYYY_median.png (2024, 2025, 2026年 中央値時系列図・濃い青棒)\n")
