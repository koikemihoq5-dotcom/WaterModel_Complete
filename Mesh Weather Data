library(sf)
library(agrmesh)
library(dplyr)
library(purrr)

# --------------------------------------------------
# 1. 2025年の設定
# --------------------------------------------------
target_year  <- 2025
gpx_path     <- "C:/Users/koike/OneDrive/Desktop/Water5/00_RawData/294A_2025_wpt.gpx"
mapping_path <- "C:/Users/koike/OneDrive/Desktop/Water5/00_RawData/2025Code.csv" # 👈提供いただいた対比表CSV

start_date  <- as.Date("2025-06-01")
end_date    <- as.Date("2025-09-01")

target_elements <- c("TMP_mea", "TMP_max", "TMP_min", "APCP", "GSR")

# --------------------------------------------------
# 2. 対比表（2025Code.csv）の読み込み
# --------------------------------------------------
# タブ区切りまたはカンマ区切りの両方に対応できるよう read.csv/read.delim 調整
mapping_df <- read.csv(mapping_path, fileEncoding = "CP932", check.names = FALSE)

# もし1列に繋がって読み込まれた場合のタブ区切り対策
if (ncol(mapping_df) == 1) {
  mapping_df <- read.delim(mapping_path, fileEncoding = "CP932", check.names = FALSE)
}

# 列名の表記揺れ対策（b_pointNum と name を抽出）
mapping_df <- mapping_df %>% 
  rename(
    b_pointNum = grep("b_pointNum", names(.), value = TRUE)[1],
    plot_name  = grep("name", names(.), value = TRUE)[1]
  ) %>% 
  mutate(b_pointNum = as.character(b_pointNum))

# --------------------------------------------------
# 3. GPXデータの読み込み & 区画Noの結合
# --------------------------------------------------
gpx_data <- st_read(gpx_path, layer = "waypoints", quiet = TRUE)

sites_df <- gpx_data %>%
  mutate(
    lon = st_coordinates(.)[, 1],
    lat = st_coordinates(.)[, 2],
    
    # GPXから d_pointNumber を取得（無ければ row_number）
    d_pointNumber = if ("d_pointNumber" %in% names(.)) as.character(d_pointNumber) 
                    else as.character(row_number()),
    site_id = row_number()
  ) %>%
  st_drop_geometry() %>%
  # d_pointNumber と b_pointNum をキーにして結合
  left_join(mapping_df, by = c("d_pointNumber" = "b_pointNum")) %>% 
  # site_name に区画名（name列）をセット（対比表に無ければ d_pointNumber を使う）
  mutate(
    site_name = ifelse(!is.na(plot_name) & plot_name != "", plot_name, d_pointNumber)
  ) %>%
  select(site_id, d_pointNumber, site_name, lat, lon)

total_sites <- nrow(sites_df)

# --------------------------------------------------
# 4. 10地点ずつの分割 ＆ エラー自動リカバリ取得
# --------------------------------------------------
chunk_size  <- 10
site_chunks <- split(sites_df, ceiling(seq_len(total_sites) / chunk_size))

cat(sprintf("全 %d 地点を %d グループに分けて取得します...\n", total_sites, length(site_chunks)))

weather_2025_list <- list()

for (i in seq_along(site_chunks)) {
  chunk_df <- site_chunks[[i]]
  cat(sprintf("\n--- [グループ %d / %d] 取得中 --- \n", i, length(site_chunks)))
  
  chunk_res <- pmap_dfr(chunk_df, function(site_id, d_pointNumber, site_name, lat, lon) {
    
    res <- tryCatch({
      fetch_amgsds(
        lat = lat,
        lon = lon,
        time = c(start_date, end_date),
        elements = target_elements
      )
    }, error = function(e) {
      cat(sprintf("\n⚠️ 地点 %s で認証切断を検知。再認証を行います...\n", site_name))
      amgsds_config()
      
      fetch_amgsds(
        lat = lat,
        lon = lon,
        time = c(start_date, end_date),
        elements = target_elements
      )
    })
    
    percent <- round((site_id / total_sites) * 100)
    cat(sprintf("\r[進捗: %3d%%] %d / %d 地点完了 (現在: %-12s)", percent, site_id, total_sites, site_name))
    flush.console()
    
    res %>% 
      mutate(
        year = target_year,
        site_id = site_id,
        d_pointNumber = d_pointNumber, # 番号（1, 2, 3...）
        site_name = site_name          # 区画名（107_5, A, 108_4...）
      )
  })
  
  weather_2025_list[[i]] <- chunk_res
}

cat("\n\n全地点の取得が完了しました。データを結合中...\n")

weather_2025 <- bind_rows(weather_2025_list) %>% 
  select(year, site_id, d_pointNumber, site_name, everything())

