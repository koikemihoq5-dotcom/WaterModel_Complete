#==========================================================
# 5. 観測日に累積GDDを付与
#==========================================================

stage_all <-

    stage_all %>%

    left_join(

        weather %>%
            select(
                date,
                year,
                cumGDD
            ),

        by=c("date","year")

    )

if(any(is.na(stage_all$cumGDD))){

    warning("累積GDDが取得できない日があります。")

}

#==========================================================
# 6. データ確認
#==========================================================

cat("--------------------------------------------------\n")
cat("Stage observations :", nrow(stage_all), "\n")
cat("Sites              :", n_distinct(stage_all$site), "\n")
cat("Years              :", paste(sort(unique(stage_all$year)),
                                 collapse=", "), "\n")
cat("--------------------------------------------------\n")

print(head(stage_all))

stage_all <- stage_all %>%
    mutate(cumGDD = cumGDD.x) %>%
    select(-cumGDD.x, -cumGDD.y)
#==========================================================
# 7. 地点ごとの GDD-Stage 回帰
#==========================================================

fit_result <-

    stage_all %>%

    group_by(site, year) %>%

    summarise(

        n = n(),

        intercept = coef(lm(stage ~ cumGDD))[1],

        slope     = coef(lm(stage ~ cumGDD))[2],

        R2        = summary(lm(stage ~ cumGDD))$r.squared,

        .groups="drop"

    )

#==========================================================
# 回帰結果の確認
#==========================================================

cat("\n===== Regression summary =====\n")

print(summary(fit_result$R2))

cat("\nLowest R2 sites\n")

print(

    fit_result %>%

        arrange(R2) %>%

        head(10)

)

#==========================================================
# 回帰係数を保存
#==========================================================

write.csv(

    fit_result,

    "01_ProcessedData/stage_regression_coefficients.csv",

    row.names=FALSE,

    fileEncoding="CP932"

)

cat("\nRegression coefficients saved.\n")
