# ==========================================================
# 1. 2024年・2025年のVstageデータを読み込み＆縦持ち変換（修正版）
# ==========================================================

# --- 2024年データ ---
path_2024 <- "C:/Users/koike/OneDrive/Desktop/Water261016_2/00_RawData/2024Vstage.csv"

stage_2024 <- read.csv(path_2024, stringsAsFactors = FALSE, colClasses = "character") %>%
    # NDVI, NDRE, SAVI 等の列を除外し、V_で始まるステージ列のみを縦持ち化
    pivot_longer(
        cols = starts_with("V_"), 
        names_to = "date_str",
        values_to = "stage_val"
    ) %>%
    mutate(
        year = 2024,
        date_clean = gsub("[^0-9]", "", date_str),
        date = as.Date(paste0("2024-", substr(date_clean, 1, 2), "-", substr(date_clean, 3, 4))),
        site = as.numeric(gsub("[^0-9]", "", name)),
        disease = as.numeric(disease)
    )

# --- 2025年データ ---
path_2025 <- "C:/Users/koike/OneDrive/Desktop/Water261016_2/00_RawData/2025Vstage.csv"

stage_2025 <- read.csv(path_2025, stringsAsFactors = FALSE, colClasses = "character") %>%
    pivot_longer(
        cols = starts_with("V_"), 
        names_to = "date_str",
        values_to = "stage_val"
    ) %>%
    mutate(
        year = 2025,
        date_clean = gsub("[^0-9]", "", date_str),
        date = as.Date(paste0("2025-", substr(date_clean, 1, 2), "-", substr(date_clean, 3, 4))),
        site = as.numeric(gsub("[^0-9]", "", name)),
        disease = as.numeric(disease)
    )

# ==========================================================
# 2. データの結合とステージ数値化 (stage_all の作成)
# ==========================================================

stage_all <- bind_rows(stage_2024, stage_2025) %>%
    mutate(
        stage = case_when(
            stage_val == "R1" ~ 11,
            stage_val == "R2" ~ 12,
            TRUE ~ suppressWarnings(as.numeric(stage_val))
        )
    ) %>%
    # 不要なNA行やサイト番号が無い行を除外
    filter(!is.na(stage), !is.na(site), !is.na(date)) %>% 
    select(name, site, year, date, stage, disease)

cat("--- クレンジング後の stage_all 確認 ---\n")
print(head(stage_all))
