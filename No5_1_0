library(dplyr)
library(tidyr)
library(stringr) # 文字列処理用

#==========================================================
# 0. 気象データ・フォルダ存在確認
#==========================================================
if (!exists("weather") && exists("df_weather")) {
  weather <- df_weather
}

#==========================================================
# 1. 2024年・2025年のVstageデータを読み込み＆縦持ち変換
#==========================================================

# --- 2024年データ ---
path_2024 <- "C:/Users/koike/OneDrive/Desktop/Water5/00_RawData/2024Vstage.csv"

stage_2024 <- read.csv(path_2024, stringsAsFactors = FALSE, colClasses = "character") %>%
  # 日付と思われる列（数字が含まれる列）を自動抽出
  pivot_longer(
    cols = -c(name, disease), # name と disease 以外の全列を縦持ち化
    names_to = "date_str",
    values_to = "stage_val"
  ) %>%
  mutate(
    year = 2024,
    # 日付から数字（MMDD形式）だけを抽出してYYYY-MM-DDを作る
    date_clean = gsub("[^0-9]", "", date_str),
    date = as.Date(paste0("2024-", substr(date_clean, 1, 2), "-", substr(date_clean, 3, 4))),
    # name 列から数字（site番号）だけを抽出（例: "Site_18" や "18_A" から "18" を取得）
    site = as.numeric(gsub("[^0-9]", "", name)),
    disease = as.numeric(disease)
  )

# --- 2025年データ ---
path_2025 <- "C:/Users/koike/OneDrive/Desktop/Water5/00_RawData/2025Vstage.csv"

stage_2025 <- read.csv(path_2025, stringsAsFactors = FALSE, colClasses = "character") %>%
  # 2025年も同様に name, disease 以外の列をすべて縦持ち化
  pivot_longer(
    cols = -c(name, disease), 
    names_to = "date_str",
    values_to = "stage_val"
  ) %>%
  mutate(
    year = 2025,
    date_clean = gsub("[^0-9]", "", date_str),
    date = as.Date(paste0("2025-", substr(date_clean, 1, 2), "-", substr(date_clean, 3, 4))),
    # site番号の抽出を頑健化
    site = as.numeric(gsub("[^0-9]", "", name)),
    disease = as.numeric(disease)
  )

#==========================================================
# 2. データの結合とステージ数値化 (stage_all の作成)
#==========================================================

stage_all <- bind_rows(stage_2024, stage_2025) %>%
  mutate(
    # R1 -> 11, R2 -> 12 などの変換（文字・数値両対応）
    stage = case_when(
      stage_val == "R1" ~ 11,
      stage_val == "R2" ~ 12,
      TRUE ~ as.numeric(stage_val)
    )
  ) %>%
  filter(!is.na(stage), !is.na(site)) %>% # siteがNAのものを除外
  select(name, site, year, date, stage, disease)

cat("--- stage_all の作成完了 ---\n")
print(head(stage_all))
cat("\n年度ごとのデータ件数:\n")
print(table(stage_all$year))
