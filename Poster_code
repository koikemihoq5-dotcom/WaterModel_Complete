library(dplyr)
library(ggplot2)

# 1. データの読み込み
SMC_3years <- read.csv("C:/Users/koike/OneDrive/Desktop/Water/Use/SMC_3years.csv", stringsAsFactors = FALSE)
soil_moisture_pred_3years_6to9 <- read.csv("C:/Users/koike/OneDrive/Desktop/Water/Use/soil_moisture_pred_3years_6to9.csv", stringsAsFactors = FALSE)

# 2. site列を「文字列型」に確実に統一（余分な空白も除去）
SMC_3years$site <- trimws(as.character(SMC_3years$site))
soil_moisture_pred_3years_6to9$site <- trimws(as.character(soil_moisture_pred_3years_6to9$site))

# 3. 日付型への確実な変換（ハイフン・スラッシュ両対応）
# tryFormats を使うことで 2025/6/30 でも 2025-06-30 でも自動判定します
SMC_3years$date <- as.Date(SMC_3years$date, tryFormats = c("%Y/%m/%d", "%Y-%m-%d"))
soil_moisture_pred_3years_6to9$date <- as.Date(soil_moisture_pred_3years_6to9$date, tryFormats = c("%Y/%m/%d", "%Y-%m-%d"))

