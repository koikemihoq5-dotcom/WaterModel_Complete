cat("推定データのNA件数:", sum(is.na(soil_moisture_pred_3years_6to9$date)), "\n")

# 4. 結合の実行
merged_data <- inner_join(SMC_3years, soil_moisture_pred_3years_6to9, by = c("date", "site"))

# 5. 結合結果の確認
