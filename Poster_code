# =========================================================
# 超極長＆特大文字・でかボックス版 散布図グラフ
# =========================================================
library(dplyr)
library(ggplot2)

output_dir <- "C:/Users/koike/OneDrive/Desktop/Water/Use/"

# 対象データの抽出
df_target <- df_all_wetness_summary %>%
    filter(period == "1_初期(播種-V2)", threshold == "SMC_20") %>%
    filter(!is.na(disease) & !is.na(max_cont_wet_days))

# 2次多項式回帰モデルの計算
fit_best <- lm(disease ~ poly(max_cont_wet_days, 2, raw = TRUE), data = df_target)
fit_sum  <- summary(fit_best)

# 統計数値の取得
r2_val  <- fit_sum$r.squared
adj_r2  <- fit_sum$adj.r.squared
p_val   <- pf(fit_sum$fstatistic[1], fit_sum$fstatistic[2], fit_sum$fstatistic[3], lower.tail = FALSE)

p_text  <- ifelse(p_val < 0.001, "p < 0.001", 
                  ifelse(p_val < 0.01,  "p < 0.01", 
                         ifelse(p_val < 0.05,  "p < 0.05", sprintf("p = %.3f", p_val))))

stat_label <- sprintf("R² = %.2f\nAdj. R² = %.2f\n%s", r2_val, adj_r2, p_text)

# グラフ描画
p_best_plot_ultra_wide <- ggplot(df_target, aes(x = max_cont_wet_days, y = disease)) +
    # 信頼区間付きの2次多項式回帰線
    geom_smooth(method = "lm", formula = y ~ poly(x, 2, raw = TRUE), 
                color = "#d95f02", fill = "#fdb462", alpha = 0.35, size = 1.6) +
    # データポイント（ドットも少し大きめの5.0に変更）
    geom_point(color = "#2b8cbe", alpha = 0.75, size = 5.0) +
    # 統計値テキストボックス
    annotate("label", x = max(df_target$max_cont_wet_days) * 0.78, y = max(df_target$disease) * 0.82,
             label = stat_label, fill = "white", color = "black", size = 6.0, fontface = "bold",
             label.padding = unit(0.5, "lines"), linewidth = 0.8) +
    labs(
        title = "2次多項式 (生育初期 (播種-V2期), 連続過湿日数, SMC 20% 閾値)",
        x = "連続過湿日数 (日)",
        y = "病気発生率 RCR (%)"
    ) +
    theme_bw(base_size = 14) +
    theme(
        # ★ タイトルを特大サイズ(20pt)に拡大
        plot.title       = element_text(face = "bold", size = 20, hjust = 0.5, margin = margin(b = 12)),
        # ★ X・Y軸ラベルを大幅拡大(18pt)
        axis.title       = element_text(face = "bold", size = 18),
        # ★ 目盛りの数字を大幅拡大(15pt)
        axis.text        = element_text(size = 15, face = "bold", color = "black"),
        panel.grid.minor = element_blank()
    )

print(p_best_plot_ultra_wide)

# ★ さらに横長（幅 14 インチ × 高さ 3.8 インチ）で保存
ggsave(
    paste0(output_dir, "best_model_plot_period1_smc20_ultrawide.png"), 
    plot = p_best_plot_ultra_wide, 
    width = 14, 
    height = 3.8, 
    dpi = 300
)

cat("\n【出力完了】さらに超横長・特大文字の散布図画像を保存しました！\n")

