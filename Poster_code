#大学院中間審査(D1)ポスター発表の図を作成_2026.7.27
#======================================
#結果1. 単日SMCvsRCR
#======================================
library(ggplot2)
library(dplyr)
library(tidyr)

# ---------------------------------------------------------
# 【事前処理】日付ラベルを「2025年X月X日」表記に変換
# ---------------------------------------------------------
# ※ df_long や stats_summary の生成部分で日付表記を更新します
vwc_cols <- c("vwc_0630", "vwc_0707", "vwc_0713")
date_labels <- c("2025年6月30日", "2025年7月7日", "2025年7月13日")

df_long <- MRA_RAR %>%
  select(RCR, all_of(vwc_cols)) %>%
  pivot_longer(
    cols = all_of(vwc_cols),
    names_to = "Date",
    values_to = "VWC"
  ) %>%
  na.omit()

# 日付要素を「2025年〜」の表示に変更
df_long$Date <- factor(df_long$Date, 
                       levels = vwc_cols,
                       labels = date_labels)

# 統計指標の再計算（式なし・R²とRMSEのみ）
stats_summary <- df_long %>%
  group_by(Date) %>%
  summarise(
    r2 = summary(lm(RCR ~ VWC))$r.squared,
    rmse = sqrt(mean(residuals(lm(RCR ~ VWC))^2))
  )

# ---------------------------------------------------------
# 1. 表示位置とテキスト（R²とRMSEのみ）の設定
# ---------------------------------------------------------
x_pos <- min(df_long$VWC) + (max(df_long$VWC) - min(df_long$VWC)) * 0.05
y_pos <- max(df_long$RCR) - (max(df_long$RCR) - min(df_long$RCR)) * 0.05

facet_labels <- stats_summary %>%
  mutate(
    # 式を外し、R² と RMSE のみを大きな文字で表示
    plot_label = sprintf("R² = %.2f\nRMSE = %.2f", r2, rmse),
    x = x_pos,
    y = y_pos
  )

# ---------------------------------------------------------
# 2. パネル分割プロット（縦並び・ポスター最適化版）
# ---------------------------------------------------------
# 色設定のキーも新しい日付表示に更新
custom_colors <- c(
  "2025年6月30日"  = "#2b5c8f", 
  "2025年7月7日"   = "#d95f02", 
  "2025年7月13日"  = "#7570b3"
)

p_facet_annotated <- ggplot(df_long, aes(x = VWC, y = RCR, color = Date, fill = Date)) +
  # 散布図と回帰直線
  geom_point(size = 2.5, alpha = 0.7) +
  geom_smooth(method = "lm", se = TRUE, alpha = 0.2, linewidth = 1) +
  
  # ★ R² と RMSE（文字サイズを 5.5 に大きく設定）
  geom_text(
    data = facet_labels,
    aes(x = x, y = y, label = plot_label),
    hjust = 0, vjust = 1, # 左上揃え
    size = 5.5,           # ★ 文字サイズを大きく（遠くからでも見やすく）
    fontface = "bold",    # 太字
    color = "black",
    inherit.aes = FALSE
  ) +
  
  # 日付ごとに1列3行でパネル分割
  facet_wrap(~ Date, ncol = 1) +
  
  # 色設定
  scale_color_manual(values = custom_colors) +
  scale_fill_manual(values = custom_colors) +
  
  # 軸ラベルの設定
  labs(
    x = "Volumetric Water Content (VWC)",
    y = "収穫時のRCRの割合" # ★ 縦軸を日本語表記に変更
  ) +
  
  # テーマ設定
  theme_bw(base_size = 14) +
  theme(
    strip.background = element_rect(fill = "gray90", color = "black", linewidth = 0.8),
    strip.text = element_text(face = "bold", size = 15), # パネル見出しの文字も大きく
    axis.title = element_text(face = "bold", size = 16),
    axis.text = element_text(color = "black", size = 12),
    panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8),
    panel.grid.major = element_line(color = "gray92"),
    legend.position = "none"
  )

# 画面表示
print(p_facet_annotated)

# 高解像度（300 dpi）縦長画像として保存
ggsave("RCR_vs_VWC_facet_annotated.png", plot = p_facet_annotated, width = 5.5, height = 9, dpi = 300)

